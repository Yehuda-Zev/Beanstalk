# Copy to .env (never commit .env) and set the same names in Render > Environment.
OPENAI_API_KEY=
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
# http://localhost:3000 locally, https://beanstalk.decor8.online on Render
BASE_URL=http://localhost:3000
# optional: low (default), medium, high
# IMAGE_QUALITY=low
